EMBED_COLOR_UP=#00ff41
EMBED_COLOR_DOWN=#ff0000
EMBED_COLOR_NEUTRAL=#95a5a6

# Web Dashboard
WEB_PORT=3000
SESSION_SECRET=your_random_secret_here
BASE_URL=http://localhost:3000

# Database
DB_TYPE=json
