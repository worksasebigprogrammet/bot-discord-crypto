# Discord
DISCORD_TOKEN=your_discord_bot_token
DISCORD_CLIENT_ID=your_client_id
DISCORD_CLIENT_SECRET=your_client_secret
DISCORD_GUILD_ID=your_guild_id

# CoinMarketCap
CMC_API_KEY=your_coinmarketcap_api_key

# Configuration Bot
UPDATE_INTERVAL=600000
ALERT_THRESHOLD=5
