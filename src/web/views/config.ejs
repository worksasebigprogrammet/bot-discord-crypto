<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Crypto Tracker - Configuration</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="navbar">
    <div class="nav-brand">Crypto Tracker</div>
    <div class="nav-links">
      <a href="/" class="nav-link">Dashboard</a>
      <a href="/cryptos" class="nav-link">Cryptos</a>
      <a href="/config" class="nav-link active">Config</a>
      <a href="/logs" class="nav-link">Logs</a>
      <a href="/auth/logout" class="nav-link nav-logout">Logout</a>
    </div>
  </nav>

  <main class="container">
    <div class="page-header">
      <h1>Configuration</h1>
      <p class="subtitle">Adjust bot settings and behaviour</p>
    </div>

    <div class="card">
      <h2 class="card-title">Bot Settings</h2>
      <form action="/config" method="POST" class="config-form">
        <div class="form-group">
          <label for="updateInterval">Update Interval (ms)</label>
          <input
            type="number"
            id="updateInterval"
            name="updateInterval"
            class="input"
            value="<%= config.updateInterval %>"
            min="60000"
            step="1000"
          >
          <span class="form-hint">Minimum 60000 ms (1 minute). Current: <%= Math.round(config.updateInterval / 1000) %>s</span>
        </div>

        <div class="form-group">
          <label for="alertThreshold">Alert Threshold (%)</label>
          <input
            type="number"
            id="alertThreshold"
            name="alertThreshold"
            class="input"
            value="<%= config.alertThreshold %>"
            min="0.1"
            step="0.1"
          >
          <span class="form-hint">Price change percentage that triggers an alert</span>
        </div>

        <div class="form-group">
          <label for="channelPrefix">Channel Prefix</label>
          <input
            type="text"
            id="channelPrefix"
            name="channelPrefix"
            class="input"
            value="<%= config.channelPrefix %>"
          >
          <span class="form-hint">Prefix added to auto-created price channels</span>
        </div>

        <div class="form-group">
          <label for="showLogos" class="checkbox-label">
            <input
              type="checkbox"
              id="showLogos"
              name="showLogos"
              <%= config.showLogos ? 'checked' : '' %>
            >
            Show Logos
          </label>
          <span class="form-hint">Display cryptocurrency logos in embeds</span>
        </div>

        <div class="form-group">
          <label for="timezone">Timezone</label>
          <select id="timezone" name="timezone" class="input">
            <option value="UTC" <%= config.timezone === 'UTC' ? 'selected' : '' %>>UTC</option>
            <option value="Europe/Paris" <%= config.timezone === 'Europe/Paris' ? 'selected' : '' %>>Europe/Paris</option>
            <option value="Europe/London" <%= config.timezone === 'Europe/London' ? 'selected' : '' %>>Europe/London</option>
            <option value="Europe/Berlin" <%= config.timezone === 'Europe/Berlin' ? 'selected' : '' %>>Europe/Berlin</option>
            <option value="Europe/Madrid" <%= config.timezone === 'Europe/Madrid' ? 'selected' : '' %>>Europe/Madrid</option>
            <option value="Europe/Rome" <%= config.timezone === 'Europe/Rome' ? 'selected' : '' %>>Europe/Rome</option>
            <option value="Europe/Amsterdam" <%= config.timezone === 'Europe/Amsterdam' ? 'selected' : '' %>>Europe/Amsterdam</option>
            <option value="Europe/Brussels" <%= config.timezone === 'Europe/Brussels' ? 'selected' : '' %>>Europe/Brussels</option>
            <option value="Europe/Zurich" <%= config.timezone === 'Europe/Zurich' ? 'selected' : '' %>>Europe/Zurich</option>
            <option value="America/New_York" <%= config.timezone === 'America/New_York' ? 'selected' : '' %>>America/New York</option>
            <option value="America/Chicago" <%= config.timezone === 'America/Chicago' ? 'selected' : '' %>>America/Chicago</option>
            <option value="America/Denver" <%= config.timezone === 'America/Denver' ? 'selected' : '' %>>America/Denver</option>
            <option value="America/Los_Angeles" <%= config.timezone === 'America/Los_Angeles' ? 'selected' : '' %>>America/Los Angeles</option>
            <option value="America/Toronto" <%= config.timezone === 'America/Toronto' ? 'selected' : '' %>>America/Toronto</option>
            <option value="America/Sao_Paulo" <%= config.timezone === 'America/Sao_Paulo' ? 'selected' : '' %>>America/Sao Paulo</option>
            <option value="Asia/Tokyo" <%= config.timezone === 'Asia/Tokyo' ? 'selected' : '' %>>Asia/Tokyo</option>
            <option value="Asia/Shanghai" <%= config.timezone === 'Asia/Shanghai' ? 'selected' : '' %>>Asia/Shanghai</option>
            <option value="Asia/Hong_Kong" <%= config.timezone === 'Asia/Hong_Kong' ? 'selected' : '' %>>Asia/Hong Kong</option>
            <option value="Asia/Singapore" <%= config.timezone === 'Asia/Singapore' ? 'selected' : '' %>>Asia/Singapore</option>
            <option value="Asia/Seoul" <%= config.timezone === 'Asia/Seoul' ? 'selected' : '' %>>Asia/Seoul</option>
            <option value="Asia/Dubai" <%= config.timezone === 'Asia/Dubai' ? 'selected' : '' %>>Asia/Dubai</option>
            <option value="Asia/Kolkata" <%= config.timezone === 'Asia/Kolkata' ? 'selected' : '' %>>Asia/Kolkata</option>
            <option value="Australia/Sydney" <%= config.timezone === 'Australia/Sydney' ? 'selected' : '' %>>Australia/Sydney</option>
            <option value="Pacific/Auckland" <%= config.timezone === 'Pacific/Auckland' ? 'selected' : '' %>>Pacific/Auckland</option>
          </select>
          <span class="form-hint">Timezone used for timestamps in embeds</span>
        </div>

        <div class="form-group">
          <label for="mentionHere" class="checkbox-label">
            <input
              type="checkbox"
              id="mentionHere"
              name="mentionHere"
              <%= config.mentionHere ? 'checked' : '' %>
            >
            Mention @here
          </label>
          <span class="form-hint">Include @here mention in alert notifications</span>
        </div>

        <div class="form-actions">
          <button type="submit" class="btn btn-primary">Save Changes</button>
          <a href="/config" class="btn btn-secondary">Cancel</a>
        </div>
      </form>
    </div>
  </main>
</body>
</html>
