<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Crypto Tracker - Dashboard</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="navbar">
    <div class="nav-brand">Crypto Tracker</div>
    <div class="nav-links">
      <a href="/" class="nav-link active">Dashboard</a>
      <a href="/cryptos" class="nav-link">Cryptos</a>
      <a href="/config" class="nav-link">Config</a>
      <a href="/logs" class="nav-link">Logs</a>
      <a href="/auth/logout" class="nav-link nav-logout">Logout</a>
    </div>
  </nav>

  <main class="container">
    <div class="page-header">
      <h1>Dashboard</h1>
      <p class="subtitle">Welcome back, <strong><%= user.username %></strong></p>
    </div>

    <div class="card-grid">
      <div class="card status-card">
        <div class="card-label">Bot Status</div>
        <div class="card-value">
          <span class="status-dot <%= botStatus === 'online' ? 'status-online' : 'status-offline' %>"></span>
          <%= botStatus === 'online' ? 'Online' : 'Offline' %>
        </div>
      </div>

      <div class="card status-card">
        <div class="card-label">Uptime</div>
        <div class="card-value"><%= uptime %></div>
      </div>

      <div class="card status-card">
        <div class="card-label">Guild</div>
        <div class="card-value"><%= guildName %></div>
      </div>

      <div class="card status-card">
        <div class="card-label">Tracked Cryptos</div>
        <div class="card-value"><%= trackedCount %></div>
      </div>

      <div class="card status-card">
        <div class="card-label">Active Alerts</div>
        <div class="card-value"><%= alertCount %></div>
      </div>

      <div class="card status-card">
        <div class="card-label">Next Update</div>
        <div class="card-value"><%= nextUpdate %></div>
      </div>
    </div>

    <div class="card-grid card-grid-2">
      <div class="card">
        <h2 class="card-title">Quick Actions</h2>
        <div class="actions">
          <button class="btn btn-primary" id="btn-force-update">Force Update</button>
          <a href="/cryptos" class="btn btn-secondary">Manage Cryptos</a>
          <a href="/config" class="btn btn-secondary">Edit Config</a>
        </div>
        <p id="action-status" class="action-status"></p>
      </div>

      <div class="card">
        <h2 class="card-title">Configuration Overview</h2>
        <table class="info-table">
          <tr>
            <td>Update Interval</td>
            <td><%= Math.round(config.updateInterval / 1000) %>s</td>
          </tr>
          <tr>
            <td>Alert Threshold</td>
            <td><%= config.alertThreshold %>%</td>
          </tr>
          <tr>
            <td>Channel Prefix</td>
            <td><%= config.channelPrefix %></td>
          </tr>
          <tr>
            <td>Show Logos</td>
            <td><%= config.showLogos ? 'Yes' : 'No' %></td>
          </tr>
          <tr>
            <td>Timezone</td>
            <td><%= config.timezone %></td>
          </tr>
          <tr>
            <td>Mention @here</td>
            <td><%= config.mentionHere ? 'Yes' : 'No' %></td>
          </tr>
        </table>
      </div>
    </div>
  </main>

  <script>
    document.getElementById('btn-force-update').addEventListener('click', async function () {
      const btn = this;
      const statusEl = document.getElementById('action-status');
      btn.disabled = true;
      btn.textContent = 'Updating...';
      statusEl.textContent = '';

      try {
        const res = await fetch('/api/force-update', { method: 'POST' });
        const data = await res.json();
        if (data.success) {
          statusEl.textContent = 'Update triggered successfully.';
          statusEl.className = 'action-status success';
        } else {
          statusEl.textContent = data.error || 'Update failed.';
          statusEl.className = 'action-status error';
        }
      } catch (err) {
        statusEl.textContent = 'Request failed: ' + err.message;
        statusEl.className = 'action-status error';
      }

      btn.disabled = false;
      btn.textContent = 'Force Update';
    });
  </script>
</body>
</html>
